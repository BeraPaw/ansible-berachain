; Paste your server info into this file, then copy it to inventory.ini if needed:
;   cp inventory.sample inventory.ini
;
; Replace:
; - ansible_host with your server IP/DNS
; - ansible_user with the SSH user on the server
; - ansible_ssh_private_key_file with your local private key path

[berachain_mainnet]
mainnet-prod ansible_host=<SERVER_IP> ansible_user=<NODE_USER> ansible_ssh_private_key_file=~/.ssh/<YOUR_KEY_NAME>
